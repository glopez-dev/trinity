# Mark Lombok-generated code with @lombok.Generated so JaCoCo (>= 0.8.8)
# excludes it from coverage. Without this, generated equals()/hashCode()/
# builders inflate the branch count with thousands of uncovered conditions,
# which crushes Sonar's new_coverage (combined line + branch metric).
lombok.addLombokGeneratedAnnotation = true

# This is the project root for Lombok config resolution.
config.stopBubbling = true
